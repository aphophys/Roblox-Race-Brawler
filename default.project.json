{
  "name": "RaceBrawler",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$path": "src/ReplicatedStorage",

      "RemoteEvents": {
        "$className": "Folder",
        "Combat": {
          "$className": "Folder",
          "FireTargetedSkill": { "$className": "RemoteEvent" },
          "FireGlobalSkill": { "$className": "RemoteEvent" },
          "FireSelfSkill": { "$className": "RemoteEvent" },
          "UseTrackItem": { "$className": "RemoteEvent" }
        },
        "Economy": {
          "$className": "Folder",
          "DepositFans": { "$className": "RemoteEvent" },
          "PurchaseItem": { "$className": "RemoteEvent" },
          "EquipSkill": { "$className": "RemoteEvent" }
        },
        "Hub": {
          "$className": "Folder",
          "TeleportToFanBox": { "$className": "RemoteEvent" },
          "ReturnToHub": { "$className": "RemoteEvent" },
          "PerformPose": { "$className": "RemoteEvent" },
          "EnterTrack": { "$className": "RemoteEvent" }
        },
        "Track": {
          "$className": "Folder",
          "CheckpointPassed": { "$className": "RemoteEvent" },
          "UpdateRaceStandings": { "$className": "RemoteEvent" }
        }
      },

      "Assets": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "UI_Templates": { "$className": "Folder", "$ignoreUnknownInstances": true },
        "Track_Library": { "$className": "Folder", "$ignoreUnknownInstances": true },
        "FanBox_Templates": { "$className": "Folder", "$ignoreUnknownInstances": true },
        "VFX_Library": { "$className": "Folder", "$ignoreUnknownInstances": true }
      }
    },

    "ServerStorage": {
      "$path": "src/ServerStorage"
    },

    "ServerScriptService": {
      "$path": "src/ServerScriptService",

      "Packages": {
        "$path": "ServerPackages"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "$path": "src/StarterPlayer/StarterPlayerScripts"
      }
    },

    "StarterGui": {
      "MainHUD": {
        "$className": "ScreenGui",
        "$properties": {
          "IgnoreGuiInset": true,
          "ResetOnSpawn": false
        },

        "TopLeft": {
          "$className": "Frame",
          "$properties": {
            "Size": { "UDim2": [[0.30, 0], [0.16, 0]] },
            "Position": { "UDim2": [[0.02, 0], [0.03, 0]] },
            "BackgroundColor3": { "Color3": [1, 1, 1] },
            "BackgroundTransparency": 0.15,
            "BorderSizePixel": 0
          },
          "UICorner": { "$className": "UICorner", "$properties": { "CornerRadius": { "UDim": [0, 16] } } },
          "UIStroke": { "$className": "UIStroke", "$properties": { "Color": { "Color3": [0.30, 0.67, 0.97] }, "Thickness": 2 } },
          "TitleLabel": {
            "$className": "TextLabel",
            "$properties": {
              "Size": { "UDim2": [[0.9, 0], [0.2, 0]] },
              "Position": { "UDim2": [[0.05, 0], [0.05, 0]] },
              "BackgroundTransparency": 1,
              "Text": "GRAND PRIX STANDINGS",
              "TextColor3": { "Color3": [0.18, 0.18, 0.25] },
              "Font": "GothamBold",
              "TextScaled": true,
              "TextXAlignment": "Left"
            }
          },
          "StandingsList": {
            "$className": "Frame",
            "$properties": {
              "Size": { "UDim2": [[0.9, 0], [0.55, 0]] },
              "Position": { "UDim2": [[0.05, 0], [0.27, 0]] },
              "BackgroundTransparency": 1
            },
            "UIListLayout": { "$className": "UIListLayout", "$properties": { "SortOrder": "LayoutOrder", "Padding": { "UDim": [0, 2] } } },
            "EntryTemplate": {
              "$className": "TextLabel",
              "$properties": {
                "Size": { "UDim2": [[1, 0], [0, 20]] },
                "BackgroundTransparency": 1,
                "Text": "1. PlayerName",
                "TextColor3": { "Color3": [0.18, 0.18, 0.25] },
                "Font": "Gotham",
                "TextScaled": true,
                "TextXAlignment": "Left",
                "Visible": false
              }
            }
          },
          "LapLabel": {
            "$className": "TextLabel",
            "$properties": {
              "Size": { "UDim2": [[0.9, 0], [0.15, 0]] },
              "Position": { "UDim2": [[0.05, 0], [0.83, 0]] },
              "BackgroundTransparency": 1,
              "Text": "Checkpoint 0 / 8",
              "TextColor3": { "Color3": [0.30, 0.67, 0.97] },
              "Font": "GothamBold",
              "TextScaled": true,
              "TextXAlignment": "Left"
            }
          }
        },

        "TopRight": {
          "$className": "Frame",
          "$properties": {
            "Size": { "UDim2": [[0.26, 0], [0.16, 0]] },
            "Position": { "UDim2": [[0.72, 0], [0.03, 0]] },
            "BackgroundColor3": { "Color3": [1, 1, 1] },
            "BackgroundTransparency": 0.15,
            "BorderSizePixel": 0
          },
          "UICorner": { "$className": "UICorner", "$properties": { "CornerRadius": { "UDim": [0, 16] } } },
          "UIStroke": { "$className": "UIStroke", "$properties": { "Color": { "Color3": [0.70, 0.40, 1] }, "Thickness": 2 } },
          "GoldLabel": {
            "$className": "TextLabel",
            "$properties": {
              "Size": { "UDim2": [[0.85, 0], [0.3, 0]] },
              "Position": { "UDim2": [[0.08, 0], [0.1, 0]] },
              "BackgroundTransparency": 1,
              "Text": "🪙 0",
              "TextColor3": { "Color3": [1, 0.78, 0.17] },
              "Font": "GothamBold",
              "TextScaled": true,
              "TextXAlignment": "Left"
            }
          },
          "FansLabel": {
            "$className": "TextLabel",
            "$properties": {
              "Size": { "UDim2": [[0.85, 0], [0.3, 0]] },
              "Position": { "UDim2": [[0.08, 0], [0.42, 0]] },
              "BackgroundTransparency": 1,
              "Text": "🌟 0",
              "TextColor3": { "Color3": [1, 0.41, 0.71] },
              "Font": "GothamBold",
              "TextScaled": true,
              "TextXAlignment": "Left"
            }
          },
          "SettingsButton": {
            "$className": "TextButton",
            "$properties": {
              "Size": { "UDim2": [[0.28, 0], [0.32, 0]] },
              "Position": { "UDim2": [[0.66, 0], [0.68, 0]] },
              "AnchorPoint": { "Vector2": [0, 1] },
              "BackgroundColor3": { "Color3": [0.70, 0.40, 1] },
              "BorderSizePixel": 0,
              "Text": "⚙",
              "TextColor3": { "Color3": [1, 1, 1] },
              "Font": "GothamBold",
              "TextScaled": true,
              "AutoButtonColor": true
            },
            "UICorner": { "$className": "UICorner", "$properties": { "CornerRadius": { "UDim": [1, 0] } } },
            "UIGradient": { "$className": "UIGradient", "$properties": { "Rotation": 90 } }
          }
        },

        "CenterAction": {
          "$className": "Frame",
          "$properties": {
            "Size": { "UDim2": [[0.22, 0], [0.08, 0]] },
            "Position": { "UDim2": [[0.5, 0], [0.87, 0]] },
            "AnchorPoint": { "Vector2": [0.5, 0.5] },
            "BackgroundTransparency": 1
          },
          "ActionButton": {
            "$className": "TextButton",
            "$properties": {
              "Size": { "UDim2": [[1, 0], [1, 0]] },
              "BackgroundColor3": { "Color3": [1, 0.54, 0.24] },
              "BorderSizePixel": 0,
              "Text": "DEPOSIT FANS",
              "TextColor3": { "Color3": [1, 1, 1] },
              "Font": "GothamBold",
              "TextScaled": true,
              "AutoButtonColor": true
            },
            "UICorner": { "$className": "UICorner", "$properties": { "CornerRadius": { "UDim": [0, 20] } } },
            "UIStroke": { "$className": "UIStroke", "$properties": { "Color": { "Color3": [1, 1, 1] }, "Thickness": 2 } },
            "UIGradient": { "$className": "UIGradient", "$properties": { "Rotation": 90 } }
          }
        },

        "BottomRight": {
          "$className": "Frame",
          "$properties": {
            "Size": { "UDim2": [[0.13, 0], [0.32, 0]] },
            "Position": { "UDim2": [[0.85, 0], [0.40, 0]] },
            "BackgroundTransparency": 1
          },
          "Skill1Button": {
            "$className": "TextButton",
            "$properties": {
              "Size": { "UDim2": [[0.9, 0], [0.28, 0]] },
              "Position": { "UDim2": [[0.05, 0], [0.02, 0]] },
              "BackgroundColor3": { "Color3": [0.30, 0.67, 0.97] },
              "BorderSizePixel": 0,
              "Text": "1",
              "TextColor3": { "Color3": [1, 1, 1] },
              "Font": "GothamBold",
              "TextScaled": true,
              "AutoButtonColor": true
            },
            "UICorner": { "$className": "UICorner", "$properties": { "CornerRadius": { "UDim": [1, 0] } } },
            "UIGradient": { "$className": "UIGradient", "$properties": { "Rotation": 90 } }
          },
          "Skill2Button": {
            "$className": "TextButton",
            "$properties": {
              "Size": { "UDim2": [[0.9, 0], [0.28, 0]] },
              "Position": { "UDim2": [[0.05, 0], [0.36, 0]] },
              "BackgroundColor3": { "Color3": [0.70, 0.40, 1] },
              "BorderSizePixel": 0,
              "Text": "2",
              "TextColor3": { "Color3": [1, 1, 1] },
              "Font": "GothamBold",
              "TextScaled": true,
              "AutoButtonColor": true
            },
            "UICorner": { "$className": "UICorner", "$properties": { "CornerRadius": { "UDim": [1, 0] } } },
            "UIGradient": { "$className": "UIGradient", "$properties": { "Rotation": 90 } }
          },
          "Skill3Button": {
            "$className": "TextButton",
            "$properties": {
              "Size": { "UDim2": [[0.9, 0], [0.28, 0]] },
              "Position": { "UDim2": [[0.05, 0], [0.70, 0]] },
              "BackgroundColor3": { "Color3": [0.30, 0.85, 0.39] },
              "BorderSizePixel": 0,
              "Text": "3",
              "TextColor3": { "Color3": [1, 1, 1] },
              "Font": "GothamBold",
              "TextScaled": true,
              "AutoButtonColor": true
            },
            "UICorner": { "$className": "UICorner", "$properties": { "CornerRadius": { "UDim": [1, 0] } } },
            "UIGradient": { "$className": "UIGradient", "$properties": { "Rotation": 90 } }
          }
        }
      }
    }
  }
}
